<Window x:Class="DicteeLocale.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dictée locale" Width="390" Height="80" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
 ShowActivated="False" Focusable="False" FontFamily="Segoe UI">
 <Border CornerRadius="16" BorderBrush="#354154" BorderThickness="1" Background="#F2182233" Padding="9">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="MicButton" Content="●" FontSize="21" Background="#6366F1" Width="44" Height="44" Click="ToggleClick" ToolTip="Démarrer / arrêter"/>
   <StackPanel Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center">
    <TextBlock x:Name="StatusText" Text="Chargement…" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="ShortcutText" Foreground="#98A6BB" FontSize="10" Margin="0,4,0,0" Text="Ctrl+Maj+Alt+D · local"/>
   </StackPanel>
   <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙" Click="SettingsClick" ToolTip="Réglages" FontSize="17" Padding="8,6"/>
   <Button x:Name="HideButton" Grid.Column="3" Content="×" Click="HideClick" ToolTip="Arrêter et masquer" FontSize="19" Padding="8,6"/>
  </Grid>
 </Border>
</Window>